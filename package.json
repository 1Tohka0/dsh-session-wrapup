{
  "name": "dsh-session-wrapup",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "对话收尾：把这次对话在工作区里产生的文件分好类、勾选删除，并把这个会话记进清理账本；闲置 30 分钟后自动清理。DSH 插件，自带命令行。",
  "keywords": ["dsh", "dsh-plugin", "session", "cleanup", "wrapup"],
  "license": "MIT",
  "bin": {
    "dsh-wrapup": "./bin/wrapup.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lib/*": "./lib/*",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "bin",
    "lib",
    "rules.json",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
