{
  "name": "dsh-session-wrapup",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "description": "对话收尾：把这次对话在工作区里产生的文件与文件夹分好类、全选/分组选/勾选删除，把交付物收进「成品」文件夹，并把这个会话记进清理账本；闲置 30 分钟后自动清理。DSH 插件，自带命令行。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "session",
    "cleanup",
    "wrapup"
  ],
  "license": "MIT",
  "bin": {
    "dsh-wrapup": "./bin/wrapup.mjs"
  },
  "scripts": {
    "test": "node --test test/core.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lib/*": "./lib/*",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "bin",
    "lib",
    "test",
    "rules.json",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "icon-180.png"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
